# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_key_here          # used by the generator AND the judge
# OPENAI_BASE_URL=                    # optional: any OpenAI-compatible endpoint
QDRANT_URL=http://localhost:6333      # compose overrides to http://qdrant:6333 inside the harness container
QDRANT_HOST=localhost
QDRANT_PORT=6333
HF_HOME=./.cache/huggingface          # sentence-transformers model cache
